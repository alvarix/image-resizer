{
  "name": "image-resizer",
  "version": "0.1.0",
  "description": "Resize and convert images using configurable presets",
  "main": "out/main/index.js",
  "author": "alvarix",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:mac": "electron-vite build && electron-builder --mac",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.3.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "sharp": "^0.35.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "sharp"
    ]
  },
  "build": {
    "appId": "com.alvarix.imageresizer",
    "productName": "ImageResizer",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "README.md",
      "CHANGELOG.md"
    ],
    "asarUnpack": [
      "**/node_modules/sharp/**",
      "**/node_modules/@img/**",
      "README.md",
      "CHANGELOG.md"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        "dir",
        "dmg"
      ],
      "identity": null,
      "category": "public.app-category.graphics-design",
      "fileAssociations": [
        {
          "ext": [
            "png",
            "jpg",
            "jpeg",
            "webp",
            "avif",
            "heic",
            "heif",
            "tif",
            "tiff",
            "gif"
          ],
          "name": "Image",
          "role": "Viewer"
        }
      ]
    }
  }
}
